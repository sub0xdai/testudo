# testudo-journal environment example
# Copy to .env (or .env.local) for local development.

# Backend HTTP API root (router crate). Used by src/api/client.ts.
VITE_API_URL=http://127.0.0.1:8080

# Backend WebSocket URL. Used by src/lib/ws.ts.
VITE_WS_URL=ws://127.0.0.1:4000

# WalletConnect / Reown AppKit project ID — required for wallet connect flow.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Service worker (PERF-02 CP-3) -----------------------------------------
# Opt-in flag for the journal service worker. Default OFF until the CP-4
# canary verifies stale-shell mitigations. Set to "true" to register
# `dist/sw.js` after the page is interactive.
VITE_ENABLE_SW=false

# Cache-version suffix baked into `testudo-journal-${VITE_SW_VERSION}`. Bump
# every deploy so old caches self-evict on `activate` (FR-13).
VITE_SW_VERSION=v1
