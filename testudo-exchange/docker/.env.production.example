# PostgreSQL
POSTGRES_HOST=exchange-postgres
POSTGRES_DB=exchange-db
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Rust services
SERVER_ADDR=0.0.0.0:8080
WS_STREAM_URL=0.0.0.0:4000

# Database connection (used by SQLx inside Docker)
PG__USER=root
PG__PASSWORD=CHANGE_ME
PG__HOST=exchange-postgres
PG__PORT=5432
PG__DBNAME=exchange-db
PG__POOL_MAX_SIZE=16
DATABASE_URL=postgres://${PG__USER}:${PG__PASSWORD}@${PG__HOST}:${PG__PORT}/${PG__DBNAME}

# CEX Sidecar — reachable only via internal Docker network
CCXT_SIDECAR_URL=http://exchange-sidecar:3100

# Sidecar PSK — shared secret between router and sidecar
# Generate with: openssl rand -hex 32
SIDECAR_PSK=CHANGE_ME
