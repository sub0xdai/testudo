# Testudo Exchange Environment Configuration
# Copy this file to .env and configure for your local setup

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Settings
# Used by: Backend services (router, engine, db-processor)
PG__USER=root
PG__PASSWORD=root
PG__HOST=localhost
PG__PORT=5000
PG__DBNAME=exchange-db
PG__POOL_MAX_SIZE=16

# SQLx Database URL (constructed from above values)
# This is used for migrations and sqlx compile-time checks
DATABASE_URL=postgres://root:root@localhost:5000/exchange-db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection Settings
# Used by: All backend services for pub/sub and caching
REDIS_URL=redis://localhost:6380

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# API Gateway (Router) Settings
# The main REST API server address
SERVER_ADDR=127.0.0.1:8080

# WebSocket Stream Settings
# WebSocket server for real-time market data
WS_STREAM_URL=127.0.0.1:4000

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Log Level (optional)
# Values: error, warn, info, debug, trace
# RUST_LOG=info

# Enable backtrace on panics (optional)
# RUST_BACKTRACE=1

# =============================================================================
# DOCKER CONFIGURATION (for docker/.env)
# =============================================================================

# These are used in the Docker setup for PostgreSQL and Redis containers
# Should match the PG__ values above for consistency

POSTGRES_HOST=exchange-postgres
POSTGRES_DB=exchange-db
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend API endpoints (configured in source code)
# API Base URL: http://localhost:8080/api/v1
# WebSocket URL: ws://localhost:4000
# Frontend URL: http://localhost:5173

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# For production deployment, override these values:
# - Use secure passwords
# - Use proper hostnames/IPs
# - Enable TLS/SSL
# - Configure proper database connection pooling
# - Set appropriate log levels

# Example production values (commented out):
# PG__PASSWORD=your_secure_password_here
# PG__HOST=your_database_host
# SERVER_ADDR=0.0.0.0:8080
# WS_STREAM_URL=0.0.0.0:4000
# RUST_LOG=warn