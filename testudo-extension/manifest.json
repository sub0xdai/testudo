{
  "manifest_version": 3,
  "name": "Testudo Sniper",
  "version": "0.1.0",
  "description": "Automated risk management for crypto traders. Position sizing, circuit breakers, and trade execution from TradingView.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.tradingview.com/*",
    "*://*.dexscreener.com/*",
    "*://*.gmx.io/*",
    "*://*.bybit.com/*",
    "*://api.testudo.vip/*",
    "*://ws.testudo.vip/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/*",
        "*://*.dexscreener.com/*",
        "*://*.gmx.io/*",
        "*://*.bybit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["popup/fonts/*.woff2", "page-bridge.js"],
    "matches": ["<all_urls>"]
  }]
}
